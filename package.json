{
  "name": "personal-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal plugin for Claude Code and Codex CLI",
  "scripts": {
    "sync": "node scripts/sync-mcp.mjs && node scripts/sync-codex-plugin.mjs",
    "codex:reinstall": "node scripts/codex-reinstall.mjs",
