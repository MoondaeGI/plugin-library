# Secrets
.env

# ide
.vscode

# Personal Claude settings
.claude/settings.local.json

# Personal Codex settings
.codex/.local.toml

# Codex 번들 — 로컬 생성물 (npm run sync / prepare 훅이 루트 skills/에서 재생성).
# git에 커밋하지 않는다: 설치 전 항상 sync를 돌리므로 추적할 필요가 없고,
# 루트 skills/와의 중복(바이트 단위 복사본)을 피한다.
/plugins/personal/

# Codex 에이전트 TOML — 로컬 생성물 (npm run sync / prepare / codex:reinstall이
# agents/*.md 에서 재생성). plugins/personal/와 동일 이유로 커밋하지 않는다:
# 소스 agents/*.md 와 중복이고, 설치 전 항상 sync로 재생성된다.
/codex-agents/

# 검증용 스크래치 (로고 before/after 등) — 커밋하지 않음
/.scratch/

# Node
node_modules/

# OS
Thumbs.db
.DS_Store

# Superpowers brainstorming visual companion (local state/mockups)
.superpowers/

# ppt 파이프라인 작업물 — 덱 산출물(spec.json·deck.pptx·review PNG)은 대상 폴더의
# 로컬 생성물이라 이 repo에는 커밋하지 않는다 (스모크/실사용 모두).
.slides/
